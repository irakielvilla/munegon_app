# ─────────────────────────────────────────────────────────────
# MUÑEGON POS — PLANTILLA DE VARIABLES DE ENTORNO
# ✅ Este archivo SÍ se puede subir al repositorio Git.
#
# Para desarrollo local:
#   1. Copia este archivo a .env.development
#   2. Llena los valores reales de tu proyecto Supabase
#   3. .env.development está en .gitignore (NUNCA se commitea)
#
# Para producción:
#   Las variables SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY
#   se inyectan en el entorno de compilación (option_env! en Rust).
#   No se necesita archivo .env en la máquina del cliente.
# ─────────────────────────────────────────────────────────────

# ── BASE DE DATOS LOCAL ──────────────────────────────────────
# Ruta donde se guarda el SQLite local (solo desarrollo)
MUNEGON_DB_PATH="C:/MunegonDB/dev.db"
DATABASE_URL="file:C:/MunegonDB/dev.db"

# ── SUPABASE (proyecto de desarrollo) ────────────────────────
SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# ── EDGE FUNCTIONS (fallback web) ────────────────────────────
PUBLIC_MUNEGON_API_SECRET=TU_API_SECRET

# ── SYNC ─────────────────────────────────────────────────────
# Intervalo en segundos del watcher de internet (default: 300)
SYNC_INTERVAL_SECS=300

# ── IMPUESTOS ────────────────────────────────────────────────
IVA_PORCENTAJE=16
